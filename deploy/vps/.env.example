# Copy to .env (gitignored) and fill in — or run `make env`.

# Private IP of THIS VPS — the port is published only on it (proxy reaches it, internet doesn't).
BIND_IP=10.0.0.5
# 8788 so it doesn't clash with webcake-landing-mcp (8787) on the same box.
HOST_PORT=8788

# Postgres password (OAuth store). Generate: openssl rand -hex 16
PG_PASSWORD=

# local | staging | prod
WEBCAKE_ENV=prod

# Optional
PEXELS_API_KEY=
